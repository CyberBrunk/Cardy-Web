{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/mcp-registry-auth",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/get",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPad|iPod).*"
        }
      ],
      "destination": "https://apps.apple.com/us/app/cardy-reflections/id6757249840?platform=iphone",
      "permanent": false
    },
    {
      "source": "/get",
      "destination": "https://app.cardy.today/?utm_source=qr&utm_medium=social&utm_campaign=link_in_bio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/c/:code",
      "destination": "/c/index.html"
    },
    {
      "source": "/tiktok",
      "destination": "/ig/index.html"
    }
  ]
}
